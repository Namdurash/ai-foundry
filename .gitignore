# macOS
.DS_Store

# Per-developer Claude Code state.
.claude/settings.local.json

# The active profile. aif writes this into projects it initialises and ignores
# it there for the same reason: the foundry set is a shared team asset and is
# committed, the model choice belongs to the developer.
.aif/profile.local

# Scratch space for harness runs.
/tmp/
*.log

# docs/ is working material — thoughts in progress, processed in-session, not
# a public commitment — except what is named below: the defect logs, which are
# tracked deliberately, and the cycle drawing, which scripts/cycle.sh generates
# from the code and make check verifies. (`docs/*`, not `docs/`: git cannot
# re-include a file whose directory is excluded.)
docs/*
!docs/DEFECTS-*.md
!docs/CYCLE.md
!docs/CYCLE.html
