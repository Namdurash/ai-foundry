#!/usr/bin/env bash
#
# aif — AI Foundry.
# Scaffolds an AI SDLC setup into an existing project.
#
# Targets bash 3.2 (what stock macOS ships), so: no associative arrays, no
# mapfile/readarray, no ${var,,} case conversion, no negative array indices.
# Under `set -u`, bash 3.2 also errors on "$@" when there are no positional
# parameters — hence the ${1+"$@"} guards below.

set -euo pipefail

# Every number this tool writes is data, not prose: jq parses it, awk compares
# it, the run record stores it. Under a locale whose decimal separator is a
# comma, awk's %f writes 0,0100, the next `jq --argjson` refuses it, and the
# run dies at the first station with a jq usage message for an explanation.
# So the numeric category is pinned to C. LC_ALL would outrank it, hence the
# demotion to LANG — language, dates and UTF-8 stay as the user set them.
if [ -n "${LC_ALL:-}" ]; then
  export LANG="$LC_ALL"
  unset LC_ALL
fi
export LC_NUMERIC=C

AIF_VERSION="0.5.4"

# Resolve the install root through any symlinks. Homebrew links bin/aif into
# libexec, and `readlink -f` does not exist on BSD, so walk the chain by hand.
_aif_src="${BASH_SOURCE[0]}"
while [ -L "$_aif_src" ]; do
  _aif_dir="$(cd -P "$(dirname "$_aif_src")" && pwd)"
  _aif_src="$(readlink "$_aif_src")"
  case "$_aif_src" in
    /*) ;;
    *) _aif_src="$_aif_dir/$_aif_src" ;;
  esac
done
AIF_ROOT="$(cd -P "$(dirname "$_aif_src")/.." && pwd)"
unset _aif_src _aif_dir

readonly AIF_VERSION AIF_ROOT

# Sourced explicitly and in order, never by globbing lib/*.sh: a stray file in a
# clone or a brew cellar should not become executable code.
# shellcheck source=lib/common.sh
. "$AIF_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
. "$AIF_ROOT/lib/detect.sh"
# shellcheck source=lib/profile.sh
. "$AIF_ROOT/lib/profile.sh"
# shellcheck source=lib/paths.sh
. "$AIF_ROOT/lib/paths.sh"
# shellcheck source=lib/project.sh
. "$AIF_ROOT/lib/project.sh"

aif_usage() {
  cat <<EOF
${AIF_C_BOLD}aif ${AIF_VERSION}${AIF_C_RESET} — AI Foundry

usage: aif <command> [options]

commands:
  work          Build the next Ready ticket (or a named one) headless — no questions asked
  board         The board: next-ready, move, comment, create, status, check, init
  secret        Store a token where no model sees it (set | check | rm | list)
  init          Install a foundry set into this project
  uninstall     Remove it again, reverting only what aif installed
  cost          Report what the pipeline spent, per station, from the ledger
  explain       Draw how a ticket got here — criteria, decisions, gaps
  project       Set up or validate .aif/project.json (init | check)
  doctor        What is installed, and which roles are ready on this machine
  profiles      List the available (set, runner, model) profiles
  test          Run the evals against a profile and report a pass rate
  version       Print the version
  help          Print this message

'work' is the whole dev pipeline: it takes a ready ticket and comes back with a
branch and a report, without asking anything. The roles that decide what to
build are skills — /aif-po, /aif-ba, /aif-pjm — and /aif-setup says which of
them can run on this machine.
EOF
}

# Commands prefixed with _ are the worker's and the skills', not the user's:
# run a gate, record a binding, commit an accepted stage, scaffold a ticket,
# judge one ready, meter a subagent, widen a plan's manifest.
#
# They exist as commands rather than inside their callers because each one is
# something a model must not decide or must not carry. `_record` writes the
# hash a station was once asked to copy; `_gate` renders and records a verdict;
# `_ready` is the one Definition of Ready the analyst and the worker share.
# Deliberately absent from the help above: they are an interface between two
# parts of aif, not a surface to learn.

main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then
    shift
  fi

  # Everything that touches a project hashes something. Refuse up front on a
  # machine with no digest tool, rather than let "" pass as a hash downstream.
  case "$cmd" in
    help | -h | --help | version | -V | --version | profiles) ;;
    *) aif_require_sha256 ;;
  esac

  case "$cmd" in
    init)
      # shellcheck source=lib/merge.sh
      . "$AIF_ROOT/lib/merge.sh"
      # shellcheck source=lib/manifest.sh
      . "$AIF_ROOT/lib/manifest.sh"
      # shellcheck source=lib/cmd_init.sh
      . "$AIF_ROOT/lib/cmd_init.sh"
      aif_cmd_init ${1+"$@"}
      ;;
    uninstall)
      # shellcheck source=lib/merge.sh
      . "$AIF_ROOT/lib/merge.sh"
      # shellcheck source=lib/manifest.sh
      . "$AIF_ROOT/lib/manifest.sh"
      # shellcheck source=lib/cmd_uninstall.sh
      . "$AIF_ROOT/lib/cmd_uninstall.sh"
      aif_cmd_uninstall ${1+"$@"}
      ;;
    project)
      # shellcheck source=lib/cmd_project.sh
      . "$AIF_ROOT/lib/cmd_project.sh"
      aif_cmd_project ${1+"$@"}
      ;;
    work)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_amend.sh
      . "$AIF_ROOT/lib/cmd_amend.sh"
      # shellcheck source=lib/cmd_gate.sh
      . "$AIF_ROOT/lib/cmd_gate.sh"
      # shellcheck source=lib/cmd_meter.sh
      . "$AIF_ROOT/lib/cmd_meter.sh"
      # shellcheck source=lib/secret.sh
      . "$AIF_ROOT/lib/secret.sh"
      # shellcheck source=lib/board.sh
      . "$AIF_ROOT/lib/board.sh"
      # shellcheck source=lib/run.sh
      . "$AIF_ROOT/lib/run.sh"
      # shellcheck source=lib/cmd_work.sh
      . "$AIF_ROOT/lib/cmd_work.sh"
      aif_cmd_work ${1+"$@"}
      ;;
    board)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/secret.sh
      . "$AIF_ROOT/lib/secret.sh"
      # shellcheck source=lib/board.sh
      . "$AIF_ROOT/lib/board.sh"
      # shellcheck source=lib/cmd_board.sh
      . "$AIF_ROOT/lib/cmd_board.sh"
      aif_cmd_board ${1+"$@"}
      ;;
    secret)
      # shellcheck source=lib/secret.sh
      . "$AIF_ROOT/lib/secret.sh"
      # shellcheck source=lib/cmd_secret.sh
      . "$AIF_ROOT/lib/cmd_secret.sh"
      aif_cmd_secret ${1+"$@"}
      ;;
    cost)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_cost.sh
      . "$AIF_ROOT/lib/cmd_cost.sh"
      aif_cmd_cost ${1+"$@"}
      ;;
    explain)
      # shellcheck source=lib/cmd_explain.sh
      . "$AIF_ROOT/lib/cmd_explain.sh"
      aif_cmd_explain ${1+"$@"}
      ;;
    _record)
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_record.sh
      . "$AIF_ROOT/lib/cmd_record.sh"
      aif_cmd_record ${1+"$@"}
      ;;
    _gate)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_amend.sh
      . "$AIF_ROOT/lib/cmd_amend.sh"
      # shellcheck source=lib/cmd_gate.sh
      . "$AIF_ROOT/lib/cmd_gate.sh"
      aif_cmd_gate ${1+"$@"}
      ;;
    _commit)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_gate.sh
      . "$AIF_ROOT/lib/cmd_gate.sh"
      aif_cmd_commit ${1+"$@"}
      ;;
    _ticket-init)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      aif_cmd_ticket_init ${1+"$@"}
      ;;
    _ready)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      aif_cmd_ready ${1+"$@"}
      ;;
    _meter)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_meter.sh
      . "$AIF_ROOT/lib/cmd_meter.sh"
      aif_cmd_meter ${1+"$@"}
      ;;
    _amend-plan)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/gates.sh
      . "$AIF_ROOT/lib/gates.sh"
      # shellcheck source=lib/cmd_amend.sh
      . "$AIF_ROOT/lib/cmd_amend.sh"
      aif_cmd_amend_plan ${1+"$@"}
      ;;
    doctor)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/secret.sh
      . "$AIF_ROOT/lib/secret.sh"
      # shellcheck source=lib/board.sh
      . "$AIF_ROOT/lib/board.sh"
      # shellcheck source=lib/roles.sh
      . "$AIF_ROOT/lib/roles.sh"
      # shellcheck source=lib/doctor.sh
      . "$AIF_ROOT/lib/doctor.sh"
      aif_doctor ${1+"$@"}
      ;;
    profiles)
      # shellcheck source=lib/cmd_profiles.sh
      . "$AIF_ROOT/lib/cmd_profiles.sh"
      aif_cmd_profiles ${1+"$@"}
      ;;
    test)
      # shellcheck source=lib/cmd_test.sh
      . "$AIF_ROOT/lib/cmd_test.sh"
      aif_cmd_test ${1+"$@"}
      ;;
    help | -h | --help)
      aif_usage
      ;;
    version | -V | --version)
      printf 'aif %s\n' "$AIF_VERSION"
      ;;
    *)
      aif_err "unknown command: $cmd"
      printf '\n' >&2
      aif_usage >&2
      exit 64 # EX_USAGE
      ;;
  esac
}

main ${1+"$@"}
