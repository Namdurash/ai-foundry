#!/usr/bin/env bash
#
# aif — AI Foundry.
# Scaffolds an AI SDLC setup into an existing project.
#
# Targets bash 3.2 (what stock macOS ships), so: no associative arrays, no
# mapfile/readarray, no ${var,,} case conversion, no negative array indices.
# Under `set -u`, bash 3.2 also errors on "$@" when there are no positional
# parameters — hence the ${1+"$@"} guards below.

set -euo pipefail

AIF_VERSION="0.1.0"

# Resolve the install root through any symlinks. Homebrew links bin/aif into
# libexec, and `readlink -f` does not exist on BSD, so walk the chain by hand.
_aif_src="${BASH_SOURCE[0]}"
while [ -L "$_aif_src" ]; do
  _aif_dir="$(cd -P "$(dirname "$_aif_src")" && pwd)"
  _aif_src="$(readlink "$_aif_src")"
  case "$_aif_src" in
    /*) ;;
    *) _aif_src="$_aif_dir/$_aif_src" ;;
  esac
done
AIF_ROOT="$(cd -P "$(dirname "$_aif_src")/.." && pwd)"
unset _aif_src _aif_dir

readonly AIF_VERSION AIF_ROOT

# Sourced explicitly and in order, never by globbing lib/*.sh: a stray file in a
# clone or a brew cellar should not become executable code.
# shellcheck source=lib/common.sh
. "$AIF_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
. "$AIF_ROOT/lib/detect.sh"
# shellcheck source=lib/profile.sh
. "$AIF_ROOT/lib/profile.sh"
# shellcheck source=lib/paths.sh
. "$AIF_ROOT/lib/paths.sh"
# shellcheck source=lib/project.sh
. "$AIF_ROOT/lib/project.sh"

aif_usage() {
  cat <<EOF
${AIF_C_BOLD}aif ${AIF_VERSION}${AIF_C_RESET} — AI Foundry

usage: aif <command> [options]

commands:
  init          Install a foundry set into this project
  uninstall     Remove it again, reverting only what aif installed
  start         Run the foundry against this project's profile
  run           Drive one ticket through the whole pipeline (run <ticket> [seed])
  project       Set up or validate .aif/project.json (init | check)
  create-ticket Start a ticket
  status        Show a ticket's derived state, and what is next
  station       Run a pipeline station headless (run <station> <ticket>)
  approve       The human gate — accept a specification
  doctor        Report what is installed and what aif can drive
  profiles      List the available (set, runner, model) profiles
  test          Run the evals against a profile and report a pass rate
  version       Print the version
  help          Print this message
EOF
}

main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    init)
      # shellcheck source=lib/merge.sh
      . "$AIF_ROOT/lib/merge.sh"
      # shellcheck source=lib/manifest.sh
      . "$AIF_ROOT/lib/manifest.sh"
      # shellcheck source=lib/cmd_init.sh
      . "$AIF_ROOT/lib/cmd_init.sh"
      aif_cmd_init ${1+"$@"}
      ;;
    uninstall)
      # shellcheck source=lib/merge.sh
      . "$AIF_ROOT/lib/merge.sh"
      # shellcheck source=lib/manifest.sh
      . "$AIF_ROOT/lib/manifest.sh"
      # shellcheck source=lib/cmd_uninstall.sh
      . "$AIF_ROOT/lib/cmd_uninstall.sh"
      aif_cmd_uninstall ${1+"$@"}
      ;;
    start)
      # shellcheck source=lib/manifest.sh
      . "$AIF_ROOT/lib/manifest.sh"
      # shellcheck source=lib/cmd_start.sh
      . "$AIF_ROOT/lib/cmd_start.sh"
      aif_cmd_start ${1+"$@"}
      ;;
    project)
      # shellcheck source=lib/cmd_project.sh
      . "$AIF_ROOT/lib/cmd_project.sh"
      aif_cmd_project ${1+"$@"}
      ;;
    create-ticket)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      aif_cmd_create_ticket ${1+"$@"}
      ;;
    status)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      aif_cmd_status ${1+"$@"}
      ;;
    station)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_station.sh
      . "$AIF_ROOT/lib/cmd_station.sh"
      aif_cmd_station ${1+"$@"}
      ;;
    run)
      # The orchestrator drives the ticket lifecycle (cmd_ticket) and the stations
      # (cmd_station) in-process, so both come along, plus the ledger they use.
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      # shellcheck source=lib/cmd_station.sh
      . "$AIF_ROOT/lib/cmd_station.sh"
      # shellcheck source=lib/cmd_run.sh
      . "$AIF_ROOT/lib/cmd_run.sh"
      aif_cmd_run ${1+"$@"}
      ;;
    approve)
      # shellcheck source=lib/ledger.sh
      . "$AIF_ROOT/lib/ledger.sh"
      # shellcheck source=lib/cmd_ticket.sh
      . "$AIF_ROOT/lib/cmd_ticket.sh"
      aif_cmd_approve ${1+"$@"}
      ;;
    doctor)
      # shellcheck source=lib/doctor.sh
      . "$AIF_ROOT/lib/doctor.sh"
      aif_doctor ${1+"$@"}
      ;;
    profiles)
      # shellcheck source=lib/cmd_profiles.sh
      . "$AIF_ROOT/lib/cmd_profiles.sh"
      aif_cmd_profiles ${1+"$@"}
      ;;
    test)
      # shellcheck source=lib/cmd_test.sh
      . "$AIF_ROOT/lib/cmd_test.sh"
      aif_cmd_test ${1+"$@"}
      ;;
    help | -h | --help)
      aif_usage
      ;;
    version | -V | --version)
      printf 'aif %s\n' "$AIF_VERSION"
      ;;
    *)
      aif_err "unknown command: $cmd"
      printf '\n' >&2
      aif_usage >&2
      exit 64 # EX_USAGE
      ;;
  esac
}

main ${1+"$@"}
