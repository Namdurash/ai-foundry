{
  "schema": 1,
  "ticket_pattern": "^[A-Z]{2,10}-[0-9]+$",
  "test": {
    "kind": "",
    "roots": [],
    "command": "",
    "report": {
      "path": ".aif/tmp/report.xml",
      "format": "junit"
    },
    "files": [
      "tests/*",
      "test/*",
      "__tests__/*",
      "*/tests/*",
      "*/test/*",
      "*/__tests__/*",
      "*.test.*",
      "*.spec.*",
      "*_test.*",
      "test_*.py"
    ],
    "ac_marker": "AC-[0-9]{3}"
  },
  "prepare": "",
  "deps": [
    { "manifest": "package.json", "lockfiles": ["package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml"] },
    { "manifest": "pyproject.toml", "lockfiles": ["poetry.lock", "uv.lock"] },
    { "manifest": "Cargo.toml", "lockfiles": ["Cargo.lock"] },
    { "manifest": "go.mod", "lockfiles": ["go.sum"] }
  ],
  "checks": [],
  "copies": {
    "leave_out": [],
    "link": ["node_modules", "/.venv", "/venv"]
  },
  "explain": {
    "auto": "ready"
  },
  "failure_classes": {
    "legitimate": [
      "aif: not implemented"
    ],
    "broken": [],
    "retired": []
  },
  "limits": {
    "ticket_ac_max": 15,
    "ticket_rules_max": 6,
    "ticket_examples_max": 30,
    "rule_examples_warn": 5,
    "attempts_max": 3,
    "plan_amendments_max": 3,
    "station_max_turns": 60,
    "run_dispatches_max": 16,
    "run_max_minutes": 120,
    "run_budget_usd": null,
    "repairs_max": 2,
    "replans_max": 1
  },
  "limits_retired": ["plan_files_max", "diff_lines_max", "revisions_max"],
  "risk_rules": [
    {
      "paths": [
        "**/auth/**",
        "**/payment*/**"
      ],
      "risk": "high"
    }
  ],
  "tiers": {
    "routine": "sonnet",
    "careful": "opus"
  }
}
