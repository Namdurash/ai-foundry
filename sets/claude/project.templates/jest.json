{
  "schema": 1,
  "ticket_pattern": "^[A-Z]{2,10}-[0-9]+$",
  "test": {
    "kind": "jest",
    "roots": [
      "__tests__"
    ],
    "command": "JEST_JUNIT_OUTPUT_FILE=.aif/tmp/report.xml JEST_JUNIT_ADD_FILE_ATTRIBUTE=true npx jest --ci --reporters=default --reporters=jest-junit",
    "select": "JEST_JUNIT_OUTPUT_FILE=.aif/tmp/report.xml JEST_JUNIT_ADD_FILE_ATTRIBUTE=true npx jest --ci --reporters=default --reporters=jest-junit {ids}",
    "report": {
      "path": ".aif/tmp/report.xml",
      "format": "junit"
    },
    "ac_marker": "AC-[0-9]{3}",
    "probe": {
      "path": "__tests__/aif-probe.test.js",
      "red": "test('PROBE-1 AC-001 the probe', () => {\n  expect(1).toBe(2);\n});\n",
      "green": "test('PROBE-1 AC-001 the probe', () => {\n  expect(1).toBe(1);\n});\n",
      "broken": "test('PROBE-1 AC-001 the probe', () => {\n  expect(1).toBe(\n});\n",
      "watch": [
        "jest.config.js",
        "jest.config.ts",
        "jest.config.mjs",
        "jest.config.cjs",
        "babel.config.js",
        "tsconfig.json"
      ]
    }
  },
  "prepare": "npm ci",
  "checks": [],
  "copies": {
    "leave_out": []
  },
  "explain": {
    "auto": "ready"
  },
  "failure_classes": {
    "legitimate": [
      "expect\\(",
      "toBe",
      "toEqual",
      "toThrow",
      "toHave",
      "toMatch",
      "AssertionError",
      "aif: not implemented"
    ],
    "broken": [
      "SyntaxError",
      "Unexpected token",
      "Cannot use import statement",
      "Test suite failed to run",
      "must contain at least one test",
      "Your test suite must contain"
    ],
    "retired": [
      "Cannot find module",
      "is not a function",
      "ReferenceError",
      "TypeError"
    ]
  },
  "limits": {
    "ticket_ac_max": 15,
    "ticket_rules_max": 6,
    "ticket_examples_max": 30,
    "rule_examples_warn": 5,
    "attempts_max": 3,
    "plan_amendments_max": 3,
    "station_max_turns": 60,
    "run_dispatches_max": 16,
    "run_max_minutes": 120,
    "run_budget_usd": null,
    "repairs_max": 2,
    "replans_max": 1
  },
  "limits_retired": ["plan_files_max", "diff_lines_max", "revisions_max"],
  "risk_rules": [
    {
      "paths": [
        "**/auth/**",
        "**/payment*/**",
        "**/native*/**",
        "**/*Native*"
      ],
      "risk": "high"
    }
  ],
  "tiers": {
    "routine": "sonnet",
    "careful": "opus"
  }
}
