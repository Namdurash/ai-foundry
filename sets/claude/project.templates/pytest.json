{
  "schema": 1,
  "ticket_pattern": "^[A-Z]{2,10}-[0-9]+$",

  "test": {
    "roots": ["tests"],
    "command": "pytest -q --junitxml=.aif/tmp/report.xml",
    "select": "pytest -q --junitxml=.aif/tmp/report.xml {ids}",
    "report": { "path": ".aif/tmp/report.xml", "format": "junit" },
    "ac_marker": "AC-[0-9]{3}"
  },

  "failure_classes": {
    "legitimate": [
      "AssertionError",
      "ModuleNotFoundError",
      "ImportError",
      "AttributeError",
      "NameError",
      "TypeError"
    ],
    "broken": [
      "SyntaxError",
      "IndentationError",
      "fixture .* not found",
      "ERROR collecting",
      "INTERNALERROR"
    ]
  },

  "limits": {
    "spec_ac_max": 15,
    "plan_files_max": 12,
    "diff_lines_max": 400,
    "attempts_max": 3,
    "plan_amendments_max": 3,
    "revisions_max": 5,
    "station_max_turns": 30
  },

  "risk_rules": [
    { "paths": ["**/migrations/**", "**/auth/**", "**/queue/**", "**/payment*/**"],
      "risk": "high" }
  ],

  "tiers": { "routine": "sonnet", "careful": "opus" }
}
