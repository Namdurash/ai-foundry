{
  "schema": 1,
  "ticket_pattern": "^[A-Z]{2,10}-[0-9]+$",
  "test": {
    "kind": "pytest",
    "roots": [
      "tests"
    ],
    "command": "python3 -m pytest -q --junitxml=.aif/tmp/report.xml",
    "select": "python3 -m pytest -q --junitxml=.aif/tmp/report.xml {ids}",
    "report": {
      "path": ".aif/tmp/report.xml",
      "format": "junit"
    },
    "ac_marker": "AC-[0-9]{3}"
  },
  "checks": [],
  "explain": {
    "auto": "ready"
  },
  "failure_classes": {
    "legitimate": [
      "AssertionError",
      "assert ",
      "NotImplementedError",
      "aif: not implemented"
    ],
    "broken": [
      "SyntaxError",
      "IndentationError",
      "fixture .* not found",
      "ERROR collecting",
      "INTERNALERROR"
    ],
    "retired": [
      "ModuleNotFoundError",
      "ImportError",
      "AttributeError",
      "NameError",
      "TypeError"
    ]
  },
  "limits": {
    "ticket_ac_max": 15,
    "plan_files_max": 12,
    "diff_lines_max": 400,
    "attempts_max": 3,
    "plan_amendments_max": 3,
    "station_max_turns": 60,
    "run_dispatches_max": 16,
    "run_max_minutes": 120,
    "run_budget_usd": null,
    "repairs_max": 2,
    "replans_max": 1
  },
  "risk_rules": [
    {
      "paths": [
        "**/migrations/**",
        "**/auth/**",
        "**/queue/**",
        "**/payment*/**"
      ],
      "risk": "high"
    }
  ],
  "tiers": {
    "routine": "sonnet",
    "careful": "opus"
  }
}
